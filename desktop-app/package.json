{
  "name": "desktop-assistant",
  "version": "1.0.0",
  "description": "二次元桌面助手 - Live2D 虚拟形象",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/js/renderer.js --bundle --platform=browser --format=iife --outfile=src/renderer/dist/renderer.js",
    "setup:live2d-dev": "node scripts/setup-live2d-dev.js",
    "start": "npm run build:renderer && electron .",
    "test": "npm run test:unit && npm run build:renderer && node --check src/main.js && node --check src/preload.js",
    "test:unit": "node --test tests/*.test.js",
    "build": "npm run build:renderer && electron-builder"
  },
  "keywords": [
    "electron",
    "live2d",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "6.5.10"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  }
}
