NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
ASSISTANT_LLM_ENABLED=true
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
ASSISTANT_LLM_MODEL=deepseek-chat
ASSISTANT_LLM_TOOL_CALLING_ENABLED=true
ASSISTANT_QQ_ENABLED=true
ASSISTANT_QQ_ALLOWED_USER_IDS=
ASSISTANT_QQ_ALLOWED_GROUP_IDS=
ASSISTANT_QQ_RATE_PER_MINUTE=10
ASSISTANT_QQ_RATE_BURST=2
ASSISTANT_QQ_MAX_CONCURRENCY=4
ASSISTANT_QQ_ACTION_TIMEOUT_SECONDS=10
